<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Allow existing files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Route all other URLs to index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Security: Prevent viewing hidden files or sensitive directories
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
