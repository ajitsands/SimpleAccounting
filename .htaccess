<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Allow existing files and directories to be served directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # Route all other URLs to index.html for SPA client routing
    RewriteRule ^ index.html [L]
</IfModule>

# Security: Prevent viewing hidden files or sensitive directories
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
